# ── Efettiva OS — variáveis de ambiente ──
# Copie para .env (ou rode `bash scripts/setup-env.sh`, que gera segredos aleatórios).
# NUNCA commite o arquivo .env.

# Banco de dados (dentro do docker compose o host vira "postgres" automaticamente)
POSTGRES_USER=efettiva
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=efettiva
DATABASE_URL=postgresql://efettiva:troque-esta-senha@localhost:5433/efettiva

# Redis / BullMQ (dentro do docker compose o host vira "redis")
REDIS_URL=redis://localhost:6380

# URL pública da aplicação (validação de origem / CSRF)
APP_URL=http://localhost:3000

# Chave para cifrar dados sensíveis (CPF/CNPJ). Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Diretório privado de arquivos (volume Docker em produção)
STORAGE_DIR=./storage

# Duração da sessão em horas
SESSION_TTL_HOURS=12

# Primeiro usuário OWNER — lido por `npm run bootstrap:owner` e na subida do container.
# Só cria se ainda não existir nenhum OWNER. Senha com no mínimo 12 caracteres.
# Recomenda-se apagar OWNER_PASSWORD do .env após o primeiro acesso.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# IA (Fase 5) — opcional. Sem chave o sistema funciona com templates.
ANTHROPIC_API_KEY=

# Portas publicadas no host pelo docker compose
WEB_PORT=3000
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380

LOG_LEVEL=info
