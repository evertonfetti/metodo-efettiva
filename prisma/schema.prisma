// Efettiva OS — schema relacional (contrato lógico: seção 5 da especificação)
// Convenções: UUID, clientId obrigatório em entidades de cliente, Decimal para dinheiro.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── 5.1 Autenticação e empresas ─────────────────────────

enum UserRole {
  OWNER
  CONSULTANT
  VIEWER
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String
  name           String
  role           UserRole  @default(CONSULTANT)
  active         Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  sessions       Session[]
  ownedClients   Client[]       @relation("ClientOwner")
  clientAccess   ClientAccess[]
  auditEvents    AuditEvent[]
  notes          ClientNote[]
  ownedProjects  Project[]      @relation("ProjectOwner")
  assignedTasks  ActionTask[]   @relation("TaskAssignee")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Client {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?
  taxIdEncrypted     String?
  industry           String
  industryOther      String?
  size               String?
  city               String?
  state              String?
  timezone           String       @default("America/Sao_Paulo")
  salesModel         String?
  salesChannels      String[]     @default([])
  sellersCount       Int?
  sourceSystem       String?
  salesCycle         String?
  typicalPurchaseFrequencyDays Int?
  mainChallenges     String?
  tags               String[]     @default([])
  status             ClientStatus @default(ACTIVE)
  isDemo             Boolean      @default(false)
  externalAiAllowed  Boolean      @default(false)
  ownerUserId        String       @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?    @db.Timestamptz(3)

  owner   User           @relation("ClientOwner", fields: [ownerUserId], references: [id])
  access      ClientAccess[]
  files       FileAsset[]
  jobs        BackgroundJob[]
  contacts    ClientContact[]
  notes       ClientNote[]
  assessments Assessment[]
  findings    Finding[]
  opportunities        Opportunity[]
  opportunityProcesses OpportunityProcess[]
  projects             Project[]
  projectProcesses     ProjectProcess[]
  tasks                ActionTask[]
  actionEvidences      ActionEvidence[]

  @@index([status])
  @@index([name])
}

enum ClientPermission {
  EDIT
  VIEW
}

model ClientAccess {
  clientId   String           @db.Uuid
  userId     String           @db.Uuid
  permission ClientPermission @default(EDIT)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  clientId    String?  @db.Uuid
  entityType  String
  entityId    String?
  action      String
  beforeHash  String?
  afterHash   String?
  meta        Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([entityType, entityId])
}

enum FileAccessLevel {
  INTERNAL
  CLIENT
}

model FileAsset {
  id           String          @id @default(uuid()) @db.Uuid
  clientId     String?         @db.Uuid
  uploadedBy   String?         @db.Uuid
  originalName String
  storageKey   String          @unique
  sha256       String
  mime         String
  bytes        Int
  accessLevel  FileAccessLevel @default(INTERNAL)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  client    Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  evidences       AssessmentEvidence[]
  actionEvidences ActionEvidence[]

  @@index([clientId])
}

// ───────────────────────── Jobs e configuração ─────────────────────────

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  clientId       String?   @db.Uuid
  operation      String
  status         JobStatus @default(QUEUED)
  progress       Int       @default(0)
  idempotencyKey String    @unique
  payloadJson    Json?
  resultJson     Json?
  errorMessage   String?
  attempts       Int       @default(0)
  createdBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  startedAt      DateTime? @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

model SystemSetting {
  key       String   @id
  valueJson Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ClientContact {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @db.Uuid
  name               String
  role               String?
  email              String?
  phone              String?
  notes              String?
  dataProcessingNote String?
  isDemo             Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum NoteVisibility {
  INTERNO
  CLIENTE
}

model ClientNote {
  id         String         @id @default(uuid()) @db.Uuid
  clientId   String         @db.Uuid
  authorId   String         @db.Uuid
  body       String
  visibility NoteVisibility @default(INTERNO)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([clientId, createdAt])
}

// ───────────────────────── 5.2 Diagnósticos e questionários ─────────────────────────

enum TemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model AssessmentTemplate {
  id        String         @id @default(uuid()) @db.Uuid
  code      String
  name      String
  version   Int
  industry  String         @default("GERAL")
  status    TemplateStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  domains     AssessmentDomain[]
  questions   AssessmentQuestion[]
  rules       AssessmentRule[]
  assessments Assessment[]

  @@unique([code, version])
}

model AssessmentDomain {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @db.Uuid
  code       String
  name       String
  sortOrder  Int

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
}

enum QuestionType {
  SCALE_0_5
  BOOLEAN
  SINGLE_CHOICE
  MULTI_CHOICE
  NUMBER
  CURRENCY
  PERCENT
  DATE
  TEXT
}

model AssessmentQuestion {
  id                  String       @id @default(uuid()) @db.Uuid
  templateId          String       @db.Uuid
  domainCode          String
  questionCode        String
  title               String
  type                QuestionType
  required            Boolean      @default(false)
  weight              Decimal      @default(1) @db.Decimal(6, 2)
  sortOrder           Int
  optionsJson         Json?
  guidance            String?
  allowUnknown        Boolean      @default(true)
  allowNotApplicable  Boolean      @default(true)
  allowEvidence       Boolean      @default(true)
  allowNotes          Boolean      @default(true)
  applicableByDefault Boolean      @default(true)

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rules    AssessmentRule[]
  answers  AssessmentAnswer[]

  @@unique([templateId, questionCode])
  @@index([templateId, domainCode, sortOrder])
}

enum RuleEffect {
  SHOW
  HIDE
}

/// Regra condicional editável: DSL limitada (and/or/not/equals/in/greaterThan/lessThan) sobre segmento e respostas.
model AssessmentRule {
  id               String     @id @default(uuid()) @db.Uuid
  templateId       String     @db.Uuid
  targetQuestionId String     @db.Uuid
  code             String
  effect           RuleEffect
  conditionJson    Json
  reason           String
  active           Boolean    @default(true)
  isSeed           Boolean    @default(false)
  updatedBy        String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  target   AssessmentQuestion @relation(fields: [targetQuestionId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
}

enum AssessmentStatus {
  DRAFT
  IN_REVIEW
  FINALIZED
}

model Assessment {
  id                 String           @id @default(uuid()) @db.Uuid
  clientId           String           @db.Uuid
  templateId         String           @db.Uuid
  number             Int
  revision           Int              @default(0)
  parentAssessmentId String?          @db.Uuid
  segment            String
  periodStart        DateTime?        @db.Date
  periodEnd          DateTime?        @db.Date
  status             AssessmentStatus @default(DRAFT)
  isDemo             Boolean          @default(false)
  startedAt          DateTime         @default(now()) @db.Timestamptz(3)
  finalizedAt        DateTime?        @db.Timestamptz(3)
  finalizedBy        String?          @db.Uuid
  snapshotJson       Json?
  createdBy          String           @db.Uuid
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template AssessmentTemplate @relation(fields: [templateId], references: [id])
  parent   Assessment?        @relation("AssessmentRevision", fields: [parentAssessmentId], references: [id])
  children Assessment[]       @relation("AssessmentRevision")
  answers  AssessmentAnswer[]
  scores   AssessmentScore[]
  findings Finding[]

  @@unique([clientId, number, revision])
  @@index([clientId, startedAt])
}

enum AnswerConfidence {
  VERIFIED
  REPORTED
  ESTIMATED
}

model AssessmentAnswer {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @db.Uuid
  assessmentId String           @db.Uuid
  questionId   String           @db.Uuid
  valueJson    Json
  confidence   AnswerConfidence @default(REPORTED)
  respondent   String?
  source       String?
  notes        String?
  updatedBy    String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion   @relation(fields: [questionId], references: [id])
  evidences  AssessmentEvidence[]

  @@unique([assessmentId, questionId])
  @@index([clientId])
}

model AssessmentEvidence {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @db.Uuid
  assessmentAnswerId String   @db.Uuid
  fileAssetId        String?  @db.Uuid
  note               String?
  url                String?
  createdBy          String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  answer AssessmentAnswer @relation(fields: [assessmentAnswerId], references: [id], onDelete: Cascade)
  file   FileAsset?       @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model AssessmentScore {
  id               String   @id @default(uuid()) @db.Uuid
  clientId         String   @db.Uuid
  assessmentId     String   @db.Uuid
  domainCode       String
  weightedScore    Decimal? @db.Decimal(6, 3)
  answeredWeight   Decimal  @db.Decimal(10, 2)
  applicableWeight Decimal  @db.Decimal(10, 2)
  unknownCount     Int      @default(0)
  coverage         Decimal  @db.Decimal(6, 4)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, domainCode])
  @@index([clientId])
}

// ───────────────────────── 5.4 Achados ─────────────────────────

enum FindingOrigin {
  RULE
  CONSULTANT
  AI_SUGGESTION
}

enum FindingType {
  PROBLEM
  OPPORTUNITY
  RISK
  DATA_GAP
  STRENGTH
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum FindingStatus {
  DETECTED
  REVIEWED
  APPROVED
  DISMISSED
}

model Finding {
  id            String          @id @default(uuid()) @db.Uuid
  clientId      String          @db.Uuid
  assessmentId  String?         @db.Uuid
  type          FindingType
  domainCode    String
  title         String
  description   String
  origin        FindingOrigin
  severity      Severity        @default(MEDIUM)
  confidence    ConfidenceLevel @default(MEDIUM)
  evidenceJson  Json?
  ruleKey       String?
  status        FindingStatus   @default(DETECTED)
  dismissReason String?
  isDemo        Boolean         @default(false)
  createdBy     String?         @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assessment    Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]

  @@unique([assessmentId, ruleKey])
  @@index([clientId, status])
}

// ───────────────────────── Fase 2: biblioteca, oportunidades, projetos ─────────────────────────

/// Catálogo global de processos (146 do Anexo A). Ficha detalhada em contentJson (schema Zod em features/processes).
model ProcessDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  domainCode     String
  domainName     String
  name           String
  objective      String
  seedStatus     String   @default("BASIC") // BASIC | CORE (seed)
  hasFullSheet   Boolean  @default(false)
  contentJson    Json?
  industryTagsJson Json?
  active         Boolean  @default(true)
  baseVersion    Int      @default(1)
  currentVersion Int      @default(1)
  customized     Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  revisions     ProcessRevision[]
  opportunities OpportunityProcess[]
  projects      ProjectProcess[]

  @@index([domainCode])
}

/// Histórico imutável: cada edição cria uma revisão com o conteúdo completo.
model ProcessRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  processDefinitionId String   @db.Uuid
  version             Int
  changeNotes         String
  contentJson         Json
  source              String   @default("SEED") // SEED | EDIT
  changedBy           String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  process ProcessDefinition @relation(fields: [processDefinitionId], references: [id], onDelete: Cascade)

  @@unique([processDefinitionId, version])
}

enum OpportunityStatus {
  DETECTED
  REVIEWED
  APPROVED
  DISMISSED
  LINKED_TO_PROJECT
}

model Opportunity {
  id                       String            @id @default(uuid()) @db.Uuid
  clientId                 String            @db.Uuid
  number                   Int
  findingId                String?           @db.Uuid
  projectId                String?           @db.Uuid
  title                    String
  explanation              String
  expectedOutcome          String?
  domainCode               String
  origin                   FindingOrigin
  impactScore              Int
  confidenceScore          Int
  effortScore              Int
  priorityScore            Decimal           @db.Decimal(5, 2)
  criticalRisk             Boolean           @default(false)
  criticalRiskReason       String?
  urgency                  Int?
  dependency               String?
  costEstimate             Decimal?          @db.Decimal(14, 2)
  timeToImpact             String?
  consultantOverrideReason String?
  estimatedValue           Decimal?          @db.Decimal(14, 2)
  estimateType             String?
  assumptionsJson          Json              @default("[]")
  evidenceJson             Json              @default("[]")
  missingData              String?
  status                   OpportunityStatus @default(DETECTED)
  statusReason             String?
  reviewerId               String?           @db.Uuid
  reviewedAt               DateTime?         @db.Timestamptz(3)
  approvedAt               DateTime?         @db.Timestamptz(3)
  isDemo                   Boolean           @default(false)
  createdBy                String?           @db.Uuid
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)

  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  finding   Finding?             @relation(fields: [findingId], references: [id], onDelete: SetNull)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  processes OpportunityProcess[]

  @@unique([clientId, number])
  @@index([clientId, status])
}

model OpportunityProcess {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @db.Uuid
  opportunityId       String   @db.Uuid
  processDefinitionId String   @db.Uuid
  rationale           String?
  rank                Int      @default(0)
  selected            Boolean  @default(true)
  suggested           Boolean  @default(false)
  selectedBy          String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  process     ProcessDefinition @relation(fields: [processDefinitionId], references: [id])

  @@unique([opportunityId, processDefinitionId])
  @@index([clientId])
}

enum ProjectStatus {
  DRAFT
  APPROVED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  clientId         String        @db.Uuid
  number           Int
  name             String
  scope            String?
  objectivesJson   Json          @default("[]")
  startDate        DateTime      @db.Date
  targetDate       DateTime      @db.Date
  status           ProjectStatus @default(DRAFT)
  ownerUserId      String        @db.Uuid
  sponsorName      String?
  baselineLockedAt DateTime?     @db.Timestamptz(3)
  isDemo           Boolean       @default(false)
  createdBy        String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner         User             @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  processes     ProjectProcess[]
  tasks         ActionTask[]
  opportunities Opportunity[]

  @@unique([clientId, number])
  @@index([clientId, status])
}

enum ProjectProcessStatus {
  PLANNED
  IN_PROGRESS
  PILOT
  ACTIVE
  VALIDATED
  SUSTAINED
  BLOCKED
  CANCELLED
}

/// Processo dentro do projeto, com snapshot da versão da ficha usada.
model ProjectProcess {
  id                  String               @id @default(uuid()) @db.Uuid
  clientId            String               @db.Uuid
  projectId           String               @db.Uuid
  processDefinitionId String               @db.Uuid
  processVersion      Int
  snapshotJson        Json
  status              ProjectProcessStatus @default(PLANNED)
  statusReason        String?
  ownerName           String?
  successCriteriaJson Json                 @default("[]")
  validationJson      Json?
  startDate           DateTime?            @db.Date
  targetDate          DateTime?            @db.Date
  validatedAt         DateTime?            @db.Timestamptz(3)
  sustainedAt         DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  process   ProcessDefinition @relation(fields: [processDefinitionId], references: [id])
  tasks     ActionTask[]
  evidences ActionEvidence[]

  @@unique([projectId, processDefinitionId])
  @@index([clientId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ActionTask {
  id                String       @id @default(uuid()) @db.Uuid
  clientId          String       @db.Uuid
  projectId         String       @db.Uuid
  projectProcessId  String?      @db.Uuid
  title             String
  description       String?
  assigneeUserId    String?      @db.Uuid
  externalOwnerName String?
  dueDate           DateTime?    @db.Date
  window            Int?         // 1 = dias 1–30, 2 = 31–60, 3 = 61–90
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(MEDIUM)
  checklistJson     Json         @default("[]")
  blockedReason     String?
  notes             String?
  planKey           String?
  completedAt       DateTime?    @db.Timestamptz(3)
  createdBy         String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectProcess ProjectProcess?  @relation(fields: [projectProcessId], references: [id], onDelete: SetNull)
  assignee       User?            @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  evidences      ActionEvidence[]

  @@unique([projectId, planKey])
  @@index([clientId, projectId, status])
}

model ActionEvidence {
  id               String   @id @default(uuid()) @db.Uuid
  clientId         String   @db.Uuid
  actionTaskId     String?  @db.Uuid
  projectProcessId String?  @db.Uuid
  fileAssetId      String?  @db.Uuid
  text             String?
  url              String?
  authorId         String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task           ActionTask?     @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)
  projectProcess ProjectProcess? @relation(fields: [projectProcessId], references: [id], onDelete: Cascade)
  file           FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([clientId])
}
