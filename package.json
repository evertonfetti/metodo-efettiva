    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "postinstall": "prisma generate",
    "db:seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@hookform/resolvers": "7.0.8",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.15.1",
    "dotenv": "18.0.10",
    "ioredis": "6.0.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playwright": "1.65.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "read-excel-file": "9.3.14",
    "tailwind-merge": "3.7.1",
    "tsx": "4.23.15",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "fflate": "0.8.3",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
